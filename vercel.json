{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/dashboard", "destination": "/admin/dashboard", "permanent": false },
    { "source": "/app", "destination": "/crew/app", "permanent": false }
  ],
  "rewrites": [
    { "source": "/pesan", "destination": "/form-pemesanan.html" },
    { "source": "/konfirmasi", "destination": "/konfirmasi.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/index.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/crew", "destination": "/crew/index.html" },
    { "source": "/crew/login", "destination": "/crew/index.html" },
    { "source": "/crew/app", "destination": "/crew/app.html" }
  ]
}
